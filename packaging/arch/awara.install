# post-install hooks: refresh the desktop database and icon cache so the
# menu entry and icon are visible immediately on KDE/GNOME.
# The tools may be absent on minimal systems — degrade gracefully.

post_install() {
  update-desktop-database -q /usr/share/applications 2>/dev/null || true
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
}

post_upgrade() {
  post_install
}

post_remove() {
  post_install
}
